# Port the API listens on
PORT=3000
# Public base URL of this server (used to build URLs for uploaded files)
SERVER_URL=http://localhost:3000
# Origin of the Vite client (CORS)
CLIENT_URL=http://localhost:5173
# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/xmusic
# Secret used to sign JWT auth cookies
JWT_SECRET=change-me
# YouTube Data API v3 key, needed for searching YouTube from the app.
# Create one at https://console.cloud.google.com/apis/credentials and enable
# "YouTube Data API v3". Leave empty to disable search (pasted links still work).
YOUTUBE_API_KEY=AIzaSyC4Cc4acvr3NBQtVaX6fEGn3qx3o612jpc
# Only for `npm run remote` (terminal remote control, a dev tool): the
# account whose open XMusic tab it controls
XMUSIC_EMAIL=
XMUSIC_PASSWORD=
# ChatGPT / MCP. ChatGPT signs in with OAuth (the /connect page). For local
# testing only, requests to /mcp without a token from this machine (not
# through a tunnel) act as the XMusic account with this email. Never used
# when NODE_ENV=production.
MCP_DEV_USER=
# Public https URL of this server when ChatGPT reaches it through a tunnel
# (e.g. https://xyz.trycloudflare.com). It's the OAuth issuer and token
# audience, so ChatGPT must reconnect when it changes. Empty = SERVER_URL.
PUBLIC_URL=https://abilities-deluxe-mounted-sounds.trycloudflare.com
# Google sign-in ("Continue with Google"). OAuth client id from Google Cloud
# Console > APIs & Services > Credentials > OAuth client ID > Web application,
# with your client URL (e.g. http://localhost:5173) as an authorized
# JavaScript origin. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=995425985633-erfjo0jv0v640qlo6rkggpcsd6ip3qno.apps.googleusercontent.com
