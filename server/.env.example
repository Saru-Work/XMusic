# Port the API listens on
PORT=3000
# Public base URL of this server (used to build URLs for uploaded files)
SERVER_URL=http://localhost:3000
# Origin of the Vite client (CORS)
CLIENT_URL=http://localhost:5173
# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/xmusic
# Secret used to sign JWT auth cookies
JWT_SECRET=change-me
# YouTube Data API v3 key, needed for searching YouTube from the app.
# Create one at https://console.cloud.google.com/apis/credentials and enable
# "YouTube Data API v3". Leave empty to disable search (pasted links still work).
YOUTUBE_API_KEY=
# Only for `npm run remote` (terminal remote control, a dev tool): the
# account whose open XMusic tab it controls
XMUSIC_EMAIL=
XMUSIC_PASSWORD=
